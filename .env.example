# Host identity for the non-root container user.
# On Linux/WSL, check with:
#   id -u
#   id -g
# If your machine reports 1000/1000, you can leave these values as-is.
USER_NAME=appuser
HOST_UID=1000
HOST_GID=1000

# Reproducible build toolchain. Update these deliberately together with the
# lockfile and the compatibility checks in setup.sh.
UV_VERSION=0.11.28
TORCH_VERSION=2.9.1
# cpu = no NVIDIA requirement; cu126 = legacy NVIDIA; cu128 = modern NVIDIA,
# including Blackwell / RTX 50xx. Select this per machine before building.
TORCH_BACKEND=cu128

# Host-mounted directories.
# These are the variables you will usually customize per machine.
# Local portable defaults:
#   HOST_OUTPUTS_DIR=./outputs
#   HOST_DATA_DIR=./data
#   HOST_CONTAINER_HOME_DIR=./.container-home
# Example remote-VM values:
#   HOST_OUTPUTS_DIR=/scratch/your_user/thesis-metadrive/outputs
#   HOST_DATA_DIR=/scratch/your_user/thesis-metadrive/data
#   HOST_CONTAINER_HOME_DIR=/scratch/your_user/thesis-metadrive/.container-home
HOST_OUTPUTS_DIR=./outputs
HOST_DATA_DIR=./data
HOST_CONTAINER_HOME_DIR=./.container-home

# Stable in-container paths.
# These should almost never change: the code should always see the same
# canonical paths inside the container, regardless of host layout.
CONTAINER_HOME_DIR=/workspace/.container-home
CONTAINER_OUTPUTS_DIR=/workspace/outputs
CONTAINER_DATA_DIR=/workspace/data
OUTPUTS_ROOT=/workspace/outputs
DATA_ROOT=/workspace/data
SCENARIONET_DATA_ROOT=/workspace/data/scenarionet
METADRIVE_DATA_ROOT=/workspace/data/metadrive

# Waymo / ScenarioNet conversion.
# The Google Cloud URI and object pattern identify the Motion Dataset files;
# OAuth is stored by gcloud; an optional service-account JSON is referenced by
# path below and is never embedded in this file.
WAYMO_RAW_DATA_PATH=./data/waymo_raw
WAYMO_GCS_URI=gs://waymo_open_dataset_motion_v_1_2_0/uncompressed/scenario/training_20s
WAYMO_GCS_OBJECT_PATTERN=training_20s.tfrecord-*
WAYMO_SKIP_DOWNLOAD_IF_PRESENT=true
# The default downloads one shard and converts it for a safe smoke test. With a
# wildcard pattern, WAYMO_NUM_FILES limits both download and conversion; leave
# it empty only when you explicitly want every matching shard.
WAYMO_NUM_FILES=1
WAYMO_NUM_WORKERS=8
WAYMO_OVERWRITE=false
# If true, after a successful conversion delete only the local
# training_20s.tfrecord* files; the ScenarioNet database is preserved.
WAYMO_CLEANUP_RAW_AFTER_CONVERSION=false
# The one-command ScenarioNet pipeline ignores WAYMO_NUM_FILES and expands the
# converted pool in bounded, unseen-shard batches according to pipeline_v1.yaml.
# Raw batch TFRecords are removed after successful conversion by default.

# Final ScenarioNet pipeline policy is versioned exclusively in
# conf/scenarios/pipeline_v1.yaml. Edit that YAML to change scenario counts,
# seeds, split policy or validation checks. Do not duplicate those values in
# .env. This variable only selects a different YAML file, if needed.
SCENARIONET_PIPELINE_CONFIG=/workspace/thesis-metadrive/conf/scenarios/pipeline_v1.yaml
# The frozen selection index is versioned in the repository. Catalog and
# runtime paths are derived canonically from SCENARIONET_DATA_ROOT.
SCENARIONET_OVERWRITE=false
SCENARIONET_SKIP_WAYMO=false

# Optional service-account authentication. Put the JSON outside the repository
# and set only its path; leave empty for the normal gcloud OAuth flow.
GOOGLE_APPLICATION_CREDENTIALS=

# Helpful runtime defaults.
# `.env.example` is committed; `.env` is local-only and should not be committed.
WANDB_MODE=offline
HYDRA_FULL_ERROR=1
