# Host identity for the non-root container user.
# On Linux/WSL, check with:
#   id -u
#   id -g
# If your machine reports 1000/1000, you can leave these values as-is.
USER_NAME=appuser
HOST_UID=1000
HOST_GID=1000

# Host-mounted directories.
# These are the variables you will usually customize per machine.
# Local portable defaults:
#   HOST_OUTPUTS_DIR=./outputs
#   HOST_DATA_DIR=./data
#   HOST_CONTAINER_HOME_DIR=./.container-home
# Example remote-VM values:
#   HOST_OUTPUTS_DIR=/scratch/your_user/thesis-metadrive/outputs
#   HOST_DATA_DIR=/scratch/your_user/thesis-metadrive/data
#   HOST_CONTAINER_HOME_DIR=/scratch/your_user/thesis-metadrive/.container-home
HOST_OUTPUTS_DIR=./outputs
HOST_DATA_DIR=./data
HOST_CONTAINER_HOME_DIR=./.container-home

# Stable in-container paths.
# These should almost never change: the code should always see the same
# canonical paths inside the container, regardless of host layout.
CONTAINER_HOME_DIR=/workspace/.container-home
CONTAINER_OUTPUTS_DIR=/workspace/outputs
CONTAINER_DATA_DIR=/workspace/data
OUTPUTS_ROOT=/workspace/outputs
DATA_ROOT=/workspace/data
SCENARIONET_DATA_ROOT=/workspace/data/scenarionet
METADRIVE_DATA_ROOT=/workspace/data/metadrive

# Helpful runtime defaults.
# `.env.example` is committed; `.env` is local-only and should not be committed.
WANDB_MODE=offline
HYDRA_FULL_ERROR=1
